{
  "name": "typescript-starter",
  "version": "1.0.0",
  "description": "A basic typescript app starter for newbies in 2022.",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "nodemon --exec ts-node-dev src/app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run test && npm run prettier-format && npm run lint"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "config-plus": "^0.1.1",
    "export-kit": "^0.1.2",
    "logger-core": "^0.5.1",
    "onecore": "^0.6.0",
    "pg": "^8.22.0",
    "pg-promise": "^12.7.0",
    "pg-query-stream": "^4.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.3",
    "nodemon": "^3.1.14",
    "ts-loader": "^9.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
